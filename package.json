{
  "name": "yira",
  "version": "0.1.109",
  "private": true,
  "productName": "Yira",
  "description": "A terminal-centered desktop workspace with terminal, note, browser, and file tiles, Canvas, Grid, Focus, and Split views, and a Board.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaGgaSsa/yira.git"
  },
  "homepage": "https://yira-site.vercel.app",
  "bugs": {
    "url": "https://github.com/SaGgaSsa/yira/issues"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "bin": {
    "yira-board-mcp": "dist/mcp/board-mcp.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "dev": "node ./scripts/dev-workspace.mjs",
    "dev:test": "node ./scripts/dev-workspace.mjs --temp",
    "build:main": "node ./scripts/electron-vite-build.mjs main",
    "build:preload": "node ./scripts/electron-vite-build.mjs preload",
    "build:renderer": "node ./scripts/electron-vite-build.mjs renderer",
    "build": "node ./scripts/electron-vite-build.mjs all",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:linux": "npm run build && electron-builder --linux --publish always",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "keywords": [
    "terminal",
    "workspace",
    "electron",
    "canvas",
    "tiles",
    "board",
    "developer-tools",
    "desktop",
    "notes",
    "browser",
    "file-manager",
    "grid",
    "split-view"
  ],
  "author": "SaGgaSsa",
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mantine/utils": "^6.0.22",
    "@monaco-editor/react": "^4.7.0",
    "@uiw/react-md-editor": "^4.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "i18next": "26.3.6",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react-i18next": "17.0.9",
    "rehype-raw": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.yira.app",
    "productName": "Yira",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/agent-hook-client.mjs",
        "to": "agent-hook-client.mjs"
      },
      {
        "from": "resources/claude-statusline-capture.mjs",
        "to": "claude-statusline-capture.mjs"
      },
      {
        "from": "resources/linux-deb-update-launcher.sh",
        "to": "linux-deb-update-launcher.sh"
      }
    ],
    "asar": true,
    "icon": "resources/icon.png",
    "afterPack": "build/linux/after-pack.cjs",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "SaGgaSsa",
        "repo": "yira",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "Yira"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "SaGgaSsa",
      "synopsis": "Infinite canvas terminal workspace",
      "description": "Yira is an infinite canvas terminal workspace for organizing terminals, files, notes, browsers, timers, and workspace boards.",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "SaGgaSsa",
      "packageCategory": "devel",
      "afterInstall": "build/linux/deb-after-install.sh"
    },
    "appImage": {
      "executableArgs": [
        "--no-first-run"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
