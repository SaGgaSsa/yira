{
  "name": "yira",
  "version": "0.1.48",
  "private": true,
  "productName": "Yira",
  "description": "Infinite canvas terminal workspace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaGgaSsa/yira.git"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "bin": {
    "yira-board-mcp": "dist/mcp/board-mcp.js"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs && tsx --test scripts/*.test.ts src/main/agentAlerts.test.ts src/main/agentAlertBridge.test.ts src/main/agentHookConfiguration.test.ts src/shared/userSettings.test.ts src/renderer/src/utils/shortcutResolver.test.ts src/renderer/src/hooks/useKeyboardShortcuts.test.ts src/renderer/src/utils/shortcutCatalog.test.ts",
    "dev": "node ./scripts/dev-workspace.mjs",
    "build:main": "node ./scripts/electron-vite-build.mjs main",
    "build:preload": "node ./scripts/electron-vite-build.mjs preload",
    "build:renderer": "node ./scripts/electron-vite-build.mjs renderer",
    "build": "node ./scripts/electron-vite-build.mjs all",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:linux": "npm run build && electron-builder --linux --publish always",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "keywords": [],
  "author": "SaGgaSsa",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^3.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.2",
    "@blocknote/mantine": "^0.51.2",
    "@blocknote/react": "^0.51.2",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mantine/utils": "^6.0.22",
    "@monaco-editor/react": "^4.7.0",
    "@uiw/react-md-editor": "^4.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.3",
    "i18next": "26.3.6",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react-i18next": "17.0.9",
    "rehype-raw": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.yira.app",
    "productName": "Yira",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/agent-hook-client.mjs",
        "to": "agent-hook-client.mjs"
      }
    ],
    "asar": true,
    "icon": "resources/icon.png",
    "afterPack": "build/linux/after-pack.cjs",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "SaGgaSsa",
        "repo": "yira-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "desktop": {
        "StartupWMClass": "Yira"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "SaGgaSsa",
      "synopsis": "Infinite canvas terminal workspace",
      "description": "Yira is an infinite canvas terminal workspace for organizing terminals, files, notes, browsers, timers, and workspace boards.",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "SaGgaSsa",
      "packageCategory": "devel",
      "afterInstall": "build/linux/deb-after-install.sh"
    },
    "appImage": {
      "executableArgs": [
        "--no-first-run"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
